            <Code Language="csharp"><![CDATA[public static bool IsPowerOfTwo<T>(T n) where T : IBinaryInteger<T>
    => n > T.Zero && (n & (n - T.One)) == T.Zero;$end$]]></Code>
        </Snippet>
    </CodeSnippet>
