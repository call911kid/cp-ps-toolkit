    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>leg (cpleg)</Title>
            <Shortcut>cpleg</Shortcut>
            <Description>Computes the largest exponent k such that prime^k divides n!.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T LegendreExponent<T>(T n, T prime) where T : IBinaryInteger<T>
{
    T count = T.Zero;
    while (n > T.Zero)
    {
        count += n / prime;
        n /= prime;
    }

    return count;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
