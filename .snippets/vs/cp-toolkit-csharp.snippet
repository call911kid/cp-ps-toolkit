    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>comb (cpcomb)</Title>
            <Shortcut>cpcomb</Shortcut>
            <Description>Precomputes factorials and inverse factorials for modular combinatorics queries under a prime modulus.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T ModPower<T>(T @base, T exp, T mod) where T : IBinaryInteger<T>
{
    if (exp < T.Zero)
        throw new ArgumentOutOfRangeException(nameof(exp), "Negative exponent not supported.");
    if (mod <= T.Zero)
        throw new ArgumentOutOfRangeException(nameof(mod), "Modulus must be positive.");

    T result = T.One % mod;
    T b = (@base % mod + mod) % mod;

    while (exp > T.Zero)
    {
        if ((exp & T.One) == T.One)
            result = (result * b) % mod;

        b = (b * b) % mod;
        exp >>= 1;
    }

    return result;
}

public static T ModInversePrime<T>(T a, T mod) where T : IBinaryInteger<T>
    => ModPower(a, mod - (T.One + T.One), mod);

public sealed class ModularCombinatorics<T> where T : IBinaryInteger<T>
{
    private readonly T[] _fact;
    private readonly T[] _invFact;
    private readonly T _mod;
    public ModularCombinatorics(int maxN, T mod)
    {
        _mod = mod;
        _fact = new T[maxN + 1];
        _invFact = new T[maxN + 1];

        _fact[0] = T.One;
        _invFact[0] = T.One;

        for (int i = 1; i <= maxN; i++)
        {
            _fact[i] = (_fact[i - 1] * T.CreateChecked(i)) % _mod;
        }

        _invFact[maxN] = NumberTheoryToolkit.ModInversePrime(_fact[maxN], _mod);

        for (int i = maxN - 1; i >= 1; i--)
        {
            _invFact[i] = (_invFact[i + 1] * T.CreateChecked(i + 1)) % _mod;
        }
    }
    public T NCr(int n, int r)
    {
        if (r < 0 || r > n) return T.Zero;
        return (_fact[n] * _invFact[r] % _mod) * _invFact[n - r] % _mod;
    }
    public T NPr(int n, int r)
    {
        if (r < 0 || r > n) return T.Zero;
        return _fact[n] * _invFact[n - r] % _mod;
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
