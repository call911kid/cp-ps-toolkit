    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lsbi (cplsbi)</Title>
            <Shortcut>cplsbi</Shortcut>
            <Description>Returns the 0-based index of the lowest set bit, or -1 if n is 0.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static int GetLowestSetBitIndex<T>(T n) where T : IBinaryInteger<T>
    => n == T.Zero ? -1 : int.CreateTruncating(T.TrailingZeroCount(n));$end$]]></Code>
        </Snippet>
    </CodeSnippet>
