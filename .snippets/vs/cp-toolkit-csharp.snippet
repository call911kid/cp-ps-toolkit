    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>ub (cpub)</Title>
            <Shortcut>cpub</Shortcut>
            <Description>Finds the first index in [lo, hi] where source[i] &gt; target according to the comparer, or hi + 1 if not found.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static int UpperBound<T>(IReadOnlyList<T> source, int lo, int hi, T target, IComparer<T> comparer)
{
    while (lo <= hi)
    {
        int mid = lo + ((hi - lo) >> 1);

        if (comparer.Compare(source[mid], target) > 0)
            hi = mid - 1;
        else
            lo = mid + 1;
    }

    return lo;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
