    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>siv (cpsiv)</Title>
            <Shortcut>cpsiv</Shortcut>
            <Description>Generates a boolean array of size n + 1 where isPrime[i] indicates if i is prime.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static bool[] SieveOfEratosthenes(int n)
{
    if (n < 2) return new bool[Math.Max(n + 1, 0)];

    bool[] isPrime = new bool[n + 1];
    Array.Fill(isPrime, true, 2, n - 1);

    for (int i = 2; (long)i * i <= n; i++)
    {
        if (!isPrime[i]) continue;

        for (int j = i * i; j <= n; j += i)
            isPrime[j] = false;
    }

    return isPrime;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
