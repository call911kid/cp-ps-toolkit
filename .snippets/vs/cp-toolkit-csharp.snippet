    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lsiv (cplsiv)</Title>
            <Shortcut>cplsiv</Shortcut>
            <Description>Computes all primes up to n and each number&apos;s Smallest Prime Factor (SPF).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (int[] Primes, int[] Spf) LinearSieve(int n)
{
    int[] spf = new int[n + 1];
    List<int> primes = new();

    for (int i = 2; i <= n; i++)
    {
        if (spf[i] == 0)
        {
            spf[i] = i;
            primes.Add(i);
        }

        for (int j = 0; j < primes.Count && primes[j] <= spf[i] && (long)i * primes[j] <= n; j++)
        {
            spf[i * primes[j]] = primes[j];
        }
    }

    return (primes.ToArray(), spf);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
