    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>minv (cpminv)</Title>
            <Shortcut>cpminv</Shortcut>
            <Description>Computes the modular multiplicative inverse of a modulo mod.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}

public static T ModInverse<T>(T a, T mod) where T : IBinaryInteger<T>
{
    var (gcd, x, _) = ExtendedGcd(a, mod);
    if (gcd != T.One)
        throw new InvalidOperationException($"Modular inverse does not exist: {a} and {mod} are not coprime.");

    return (x % mod + mod) % mod;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>minv (cp_minv)</Title>
            <Shortcut>cp_minv</Shortcut>
            <Description>Computes the modular multiplicative inverse of a modulo mod.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}

public static T ModInverse<T>(T a, T mod) where T : IBinaryInteger<T>
{
    var (gcd, x, _) = ExtendedGcd(a, mod);
    if (gcd != T.One)
        throw new InvalidOperationException($"Modular inverse does not exist: {a} and {mod} are not coprime.");

    return (x % mod + mod) % mod;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>minv (minv)</Title>
            <Shortcut>minv</Shortcut>
            <Description>Computes the modular multiplicative inverse of a modulo mod.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}

public static T ModInverse<T>(T a, T mod) where T : IBinaryInteger<T>
{
    var (gcd, x, _) = ExtendedGcd(a, mod);
    if (gcd != T.One)
        throw new InvalidOperationException($"Modular inverse does not exist: {a} and {mod} are not coprime.");

    return (x % mod + mod) % mod;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>minv (ModInverse)</Title>
            <Shortcut>ModInverse</Shortcut>
            <Description>Computes the modular multiplicative inverse of a modulo mod.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}

public static T ModInverse<T>(T a, T mod) where T : IBinaryInteger<T>
{
    var (gcd, x, _) = ExtendedGcd(a, mod);
    if (gcd != T.One)
        throw new InvalidOperationException($"Modular inverse does not exist: {a} and {mod} are not coprime.");

    return (x % mod + mod) % mod;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>div (cpdiv)</Title>
            <Shortcut>cpdiv</Shortcut>
            <Description>Extracts all divisors of n in sorted order.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static List<T> GetDivisors<T>(T n) where T : IBinaryInteger<T>
{
    List<T> small = new();
    List<T> large = new();

    for (T i = T.One; i * i <= n; i++)
    {
        if ((n % i) != T.Zero) continue;

        small.Add(i);
        T paired = n / i;
        if (paired != i)
            large.Add(paired);
    }

    large.Reverse();
    small.AddRange(large);
    return small;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
