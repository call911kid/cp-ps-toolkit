<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>parity (cpparity)</Title>
            <Shortcut>cpparity</Shortcut>
            <Description>Checks whether the count of set bits in n is odd.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static bool HasOddParity<T>(T n) where T : IBinaryInteger<T>
    => (int.CreateTruncating(T.PopCount(n)) & 1) == 1;$end$]]></Code>
        </Snippet>
    </CodeSnippet>
