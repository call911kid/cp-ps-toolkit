    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lcm (cplcm)</Title>
            <Shortcut>cplcm</Shortcut>
            <Description>Computes the least common multiple (LCM) of two integers.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T Gcd<T>(T a, T b) where T : IBinaryInteger<T>
    => b == T.Zero ? T.Abs(a) : Gcd(b, a % b);

public static T Lcm<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (a == T.Zero || b == T.Zero) return T.Zero;
    return T.Abs((a / Gcd(a, b)) * b);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lcm (cp_lcm)</Title>
            <Shortcut>cp_lcm</Shortcut>
            <Description>Computes the least common multiple (LCM) of two integers.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T Gcd<T>(T a, T b) where T : IBinaryInteger<T>
    => b == T.Zero ? T.Abs(a) : Gcd(b, a % b);

public static T Lcm<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (a == T.Zero || b == T.Zero) return T.Zero;
    return T.Abs((a / Gcd(a, b)) * b);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lcm (lcm)</Title>
            <Shortcut>lcm</Shortcut>
            <Description>Computes the least common multiple (LCM) of two integers.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T Gcd<T>(T a, T b) where T : IBinaryInteger<T>
    => b == T.Zero ? T.Abs(a) : Gcd(b, a % b);

public static T Lcm<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (a == T.Zero || b == T.Zero) return T.Zero;
    return T.Abs((a / Gcd(a, b)) * b);
}$end$]]></Code>
