    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>ts (cpts)</Title>
            <Shortcut>cpts</Shortcut>
            <Description>Finds the integer x in [lo, hi] that optimizes f according to the predicate.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static long TernarySearch(long lo, long hi, Func<long, long> f, Func<long, long, bool> predicate)
{
    while (hi - lo > 2)
    {
        long m1 = lo + (hi - lo) / 3;
        long m2 = hi - (hi - lo) / 3;

        if (predicate(f(m1), f(m2)))
            hi = m2 - 1;
        else
            lo = m1 + 1;
    }

    long best = lo;
    for (long i = lo + 1; i <= hi; i++)
    {
        if (predicate(f(i), f(best)))
            best = i;
    }

    return best;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
