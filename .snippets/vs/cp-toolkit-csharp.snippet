    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>bs (cpbs)</Title>
            <Shortcut>cpbs</Shortcut>
            <Description>Finds the first value in [lo, hi] where predicate(val) is true, or hi + 1 if not found.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T BinarySearch<T>(T lo, T hi, Func<T, bool> predicate) where T : IBinaryInteger<T>
{
    while (lo <= hi)
    {
        T mid = lo + ((hi - lo) >> 1);

        if (predicate(mid))
            hi = mid - T.One;
        else
            lo = mid + T.One;
    }

    return lo;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
