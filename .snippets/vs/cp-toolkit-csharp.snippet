    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lsb (cplsb)</Title>
            <Shortcut>cplsb</Shortcut>
            <Description>Isolates the lowest set bit (LSB) value via two&apos;s complement (n &amp; -n).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T GetLowestSetBit<T>(T n) where T : IBinaryInteger<T>
    => n & -n;$end$]]></Code>
        </Snippet>
    </CodeSnippet>
