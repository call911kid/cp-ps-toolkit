    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>nextp (cpnextp)</Title>
            <Shortcut>cpnextp</Shortcut>
            <Description>Returns the lexicographically next integer with the same number of set bits in O(1).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T NextPermutation<T>(T mask) where T : IBinaryInteger<T>
{
    T c = mask & -mask;
    T r = mask + c;
    return (((r ^ mask) >>> (int.CreateTruncating(T.TrailingZeroCount(c)) + 2))) | r;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>nextp (cp_nextp)</Title>
