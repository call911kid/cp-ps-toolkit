    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rup1d (cprup1d)</Title>
            <Shortcut>cprup1d</Shortcut>
            <Description>A 1D range update structure providing O(1) range additions and O(N) reconstruction.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public sealed class RangeUpdate<T> where T : INumber<T>
{
    private readonly T[] _diff;
    private readonly int _length;
    public int Length => _length;
    public RangeUpdate(int length)
    {
        _length = length;
        _diff = new T[length + 1];
    }
    public RangeUpdate(ReadOnlySpan<T> source) : this(source.Length)
    {
        if (source.IsEmpty) return;

        _diff[0] = source[0];
        for (int i = 1; i < source.Length; i++)
        {
            _diff[i] = source[i] - source[i - 1];
        }
    }
    public void Add(int left, int right, T value)
    {
        _diff[left] += value;
        _diff[right + 1] -= value;
    }
    public void Add(int index, T value) => Add(index, index, value);
    public T[] Build()
    {
        T[] result = new T[_length];
        Build(result);
        return result;
    }
    public void Build(Span<T> destination)
    {
        T current = T.Zero;
        for (int i = 0; i < _length; i++)
        {
            current += _diff[i];
            destination[i] = current;
        }
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
