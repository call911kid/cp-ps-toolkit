    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>egcd (cpegcd)</Title>
            <Shortcut>cpegcd</Shortcut>
            <Description>Computes gcd(a, b) and Bézout coefficients x and y such that a*x + b*y = gcd(a, b).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>egcd (cp_egcd)</Title>
            <Shortcut>cp_egcd</Shortcut>
            <Description>Computes gcd(a, b) and Bézout coefficients x and y such that a*x + b*y = gcd(a, b).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static (T Gcd, T X, T Y) ExtendedGcd<T>(T a, T b) where T : IBinaryInteger<T>
{
    if (b == T.Zero)
        return (T.Abs(a), a < T.Zero ? -T.One : T.One, T.Zero);

    var (g, x1, y1) = ExtendedGcd(b, a % b);
    return (g, y1, x1 - (a / b) * y1);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
