    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>s2m (cps2m)</Title>
            <Shortcut>cps2m</Shortcut>
            <Description>Converts a string of lowercase English letters (&apos;a&apos;-&apos;z&apos;) into a 26-bit integer mask.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static int StringToMask(ReadOnlySpan<char> s)
{
    int mask = 0;
    foreach (char c in s)
    {
        mask |= 1 << (c - 'a');
    }

    return mask;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
