    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rup2d (cprup2d)</Title>
            <Shortcut>cprup2d</Shortcut>
            <Description>A 2D range update structure providing O(1) submatrix additions and O(R x C) reconstruction.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public sealed class RangeUpdate2D<T> where T : INumber<T>
{
    private readonly T[,] _diff;
    private readonly int _rows;
    private readonly int _cols;
    public int Rows => _rows;
    public int Cols => _cols;
    public RangeUpdate2D(int rows, int cols)
    {
        _rows = rows;
        _cols = cols;
        _diff = new T[rows + 1, cols + 1];
    }
    public RangeUpdate2D(T[,] source) : this(source.GetLength(0), source.GetLength(1))
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? source[i - 1, j] : T.Zero;
                T left = j > 0 ? source[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? source[i - 1, j - 1] : T.Zero;
                _diff[i, j] = source[i, j] - top - left + diag;
            }
        }
    }
    public void Add(int r1, int c1, int r2, int c2, T value)
    {
        _diff[r1, c1] += value;
        _diff[r1, c2 + 1] -= value;
        _diff[r2 + 1, c1] -= value;
        _diff[r2 + 1, c2 + 1] += value;
    }
    public T[,] Build()
    {
        T[,] result = new T[_rows, _cols];
        Build(result);
        return result;
    }
    public void Build(T[,] destination)
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? destination[i - 1, j] : T.Zero;
                T left = j > 0 ? destination[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? destination[i - 1, j - 1] : T.Zero;
                destination[i, j] = _diff[i, j] + top + left - diag;
            }
        }
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rup2d (cp_rup2d)</Title>
            <Shortcut>cp_rup2d</Shortcut>
            <Description>A 2D range update structure providing O(1) submatrix additions and O(R x C) reconstruction.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public sealed class RangeUpdate2D<T> where T : INumber<T>
{
    private readonly T[,] _diff;
    private readonly int _rows;
    private readonly int _cols;
    public int Rows => _rows;
    public int Cols => _cols;
    public RangeUpdate2D(int rows, int cols)
    {
        _rows = rows;
        _cols = cols;
        _diff = new T[rows + 1, cols + 1];
    }
    public RangeUpdate2D(T[,] source) : this(source.GetLength(0), source.GetLength(1))
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? source[i - 1, j] : T.Zero;
                T left = j > 0 ? source[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? source[i - 1, j - 1] : T.Zero;
                _diff[i, j] = source[i, j] - top - left + diag;
            }
        }
    }
    public void Add(int r1, int c1, int r2, int c2, T value)
    {
        _diff[r1, c1] += value;
        _diff[r1, c2 + 1] -= value;
        _diff[r2 + 1, c1] -= value;
        _diff[r2 + 1, c2 + 1] += value;
    }
    public T[,] Build()
    {
        T[,] result = new T[_rows, _cols];
        Build(result);
        return result;
    }
    public void Build(T[,] destination)
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? destination[i - 1, j] : T.Zero;
                T left = j > 0 ? destination[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? destination[i - 1, j - 1] : T.Zero;
                destination[i, j] = _diff[i, j] + top + left - diag;
            }
        }
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rup2d (rup2d)</Title>
            <Shortcut>rup2d</Shortcut>
            <Description>A 2D range update structure providing O(1) submatrix additions and O(R x C) reconstruction.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public sealed class RangeUpdate2D<T> where T : INumber<T>
{
    private readonly T[,] _diff;
    private readonly int _rows;
    private readonly int _cols;
    public int Rows => _rows;
    public int Cols => _cols;
    public RangeUpdate2D(int rows, int cols)
    {
        _rows = rows;
        _cols = cols;
        _diff = new T[rows + 1, cols + 1];
    }
    public RangeUpdate2D(T[,] source) : this(source.GetLength(0), source.GetLength(1))
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? source[i - 1, j] : T.Zero;
                T left = j > 0 ? source[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? source[i - 1, j - 1] : T.Zero;
                _diff[i, j] = source[i, j] - top - left + diag;
            }
        }
    }
    public void Add(int r1, int c1, int r2, int c2, T value)
    {
        _diff[r1, c1] += value;
        _diff[r1, c2 + 1] -= value;
        _diff[r2 + 1, c1] -= value;
        _diff[r2 + 1, c2 + 1] += value;
    }
    public T[,] Build()
    {
        T[,] result = new T[_rows, _cols];
        Build(result);
        return result;
    }
    public void Build(T[,] destination)
    {
        for (int i = 0; i < _rows; i++)
        {
            for (int j = 0; j < _cols; j++)
            {
                T top = i > 0 ? destination[i - 1, j] : T.Zero;
                T left = j > 0 ? destination[i, j - 1] : T.Zero;
                T diag = (i > 0 && j > 0) ? destination[i - 1, j - 1] : T.Zero;
                destination[i, j] = _diff[i, j] + top + left - diag;
            }
        }
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
