    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>ncr (cpncr)</Title>
            <Shortcut>cpncr</Shortcut>
            <Description>Computes nCr.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T NCr<T>(T n, T r) where T : IBinaryInteger<T>
{
    if (r < T.Zero || r > n) return T.Zero;
    if (r == T.Zero || r == n) return T.One;

    if (r > n - r)
        r = n - r;

    T result = T.One;
    for (T i = T.One; i <= r; i++)
    {
        result = (result * (n - r + i)) / i;
    }

    return result;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
