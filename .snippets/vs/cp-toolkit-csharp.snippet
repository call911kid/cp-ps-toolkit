    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>pow (cppow)</Title>
            <Shortcut>cppow</Shortcut>
            <Description>Computes base raised to exp.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T Power<T>(T @base, T exp) where T : IBinaryInteger<T>
{
    if (exp < T.Zero)
        throw new ArgumentOutOfRangeException(nameof(exp), "Negative exponent not supported.");

    T result = T.One;
    T b = @base;

    while (exp > T.Zero)
    {
        if ((exp & T.One) == T.One)
            result *= b;

        b *= b;
        exp >>= 1;
    }

    return result;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
