    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rsum (cprsum)</Title>
            <Shortcut>cprsum</Shortcut>
            <Description>Computes the sum of integers from x to y inclusive.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T RangeSum<T>(T x, T y) where T : IBinaryInteger<T>
{
    if (x > y)
        (x, y) = (y, x);

    T two = T.CreateChecked(2);
    T count = y - x + T.One;
    T sum = x + y;

    return (count % two == T.Zero)
        ? (count / two) * sum
        : count * (sum / two);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
