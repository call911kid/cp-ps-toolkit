    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>mip (cpmip)</Title>
            <Shortcut>cpmip</Shortcut>
            <Description>Computes the modular multiplicative inverse of a modulo a prime mod.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T ModPower<T>(T @base, T exp, T mod) where T : IBinaryInteger<T>
{
    if (exp < T.Zero)
        throw new ArgumentOutOfRangeException(nameof(exp), "Negative exponent not supported.");
    if (mod <= T.Zero)
        throw new ArgumentOutOfRangeException(nameof(mod), "Modulus must be positive.");

    T result = T.One % mod;
    T b = (@base % mod + mod) % mod;

    while (exp > T.Zero)
    {
        if ((exp & T.One) == T.One)
            result = (result * b) % mod;

        b = (b * b) % mod;
        exp >>= 1;
    }

    return result;
}

public static T ModInversePrime<T>(T a, T mod) where T : IBinaryInteger<T>
    => ModPower(a, mod - (T.One + T.One), mod);$end$]]></Code>
        </Snippet>
    </CodeSnippet>
