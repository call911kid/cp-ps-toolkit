    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>pf (cppf)</Title>
            <Shortcut>cppf</Shortcut>
            <Description>Computes prime factors of n along with their exponent counts.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static List<(T Prime, int Exponent)> PrimeFactorize<T>(T n) where T : IBinaryInteger<T>
{
    List<(T Prime, int Exponent)> factors = new();
    T two = T.CreateChecked(2);

    for (T d = two; d * d <= n; d += (d == two ? T.One : two))
    {
        if ((n % d) != T.Zero) continue;

        int count = 0;
        while ((n % d) == T.Zero)
        {
            count++;
            n /= d;
        }

        factors.Add((d, count));
    }

    if (n > T.One)
        factors.Add((n, 1));

    return factors;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>pf (cp_pf)</Title>
            <Shortcut>cp_pf</Shortcut>
            <Description>Computes prime factors of n along with their exponent counts.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static List<(T Prime, int Exponent)> PrimeFactorize<T>(T n) where T : IBinaryInteger<T>
{
    List<(T Prime, int Exponent)> factors = new();
    T two = T.CreateChecked(2);

    for (T d = two; d * d <= n; d += (d == two ? T.One : two))
    {
        if ((n % d) != T.Zero) continue;

        int count = 0;
        while ((n % d) == T.Zero)
        {
            count++;
            n /= d;
        }

        factors.Add((d, count));
    }

    if (n > T.One)
        factors.Add((n, 1));

    return factors;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
