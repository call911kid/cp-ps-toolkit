    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>sbit (cpsbit)</Title>
            <Shortcut>cpsbit</Shortcut>
            <Description>Sets the bit at the given 0-based index to 1 (default), or to 0 if value is false.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T SetBit<T>(T n, int index, bool value = true) where T : IBinaryInteger<T>
    => value ? n | (T.One << index) : n & ~(T.One << index);$end$]]></Code>
        </Snippet>
    </CodeSnippet>
