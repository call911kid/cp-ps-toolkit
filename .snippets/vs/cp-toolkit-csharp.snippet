    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rbit (cprbit)</Title>
            <Shortcut>cprbit</Shortcut>
            <Description>Reverses the lowest bitCount bits of n.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T ReverseBits<T>(T n, int bitCount) where T : IBinaryInteger<T>
{
    T rev = T.Zero;
    for (int i = 0; i < bitCount; i++)
    {
        rev = (rev << 1) | ((n >>> i) & T.One);
    }

    return rev;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
