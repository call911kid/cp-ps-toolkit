    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>isp2 (cpisp2)</Title>
            <Shortcut>cpisp2</Shortcut>
            <Description>Checks whether n is a positive power of two (n &gt; 0 and (n &amp; (n - 1)) == 0).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static bool IsPowerOfTwo<T>(T n) where T : IBinaryInteger<T>
    => n > T.Zero && (n & (n - T.One)) == T.Zero;$end$]]></Code>
        </Snippet>
    </CodeSnippet>
