    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>tsreal (cptsreal)</Title>
            <Shortcut>cptsreal</Shortcut>
            <Description>Finds the real number x in [lo, hi] that optimizes f according to the predicate.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static double TernarySearch(double lo, double hi, Func<double, double> f, Func<double, double, bool> predicate, int iterations = 100)
{
    for (int i = 0; i < iterations; i++)
    {
        double m1 = lo + (hi - lo) / 3.0;
        double m2 = hi - (hi - lo) / 3.0;

        if (predicate(f(m1), f(m2)))
            hi = m2;
        else
            lo = m1;
    }

    return (lo + hi) / 2.0;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>tsreal (cp_tsreal)</Title>
            <Shortcut>cp_tsreal</Shortcut>
            <Description>Finds the real number x in [lo, hi] that optimizes f according to the predicate.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static double TernarySearch(double lo, double hi, Func<double, double> f, Func<double, double, bool> predicate, int iterations = 100)
{
    for (int i = 0; i < iterations; i++)
    {
        double m1 = lo + (hi - lo) / 3.0;
        double m2 = hi - (hi - lo) / 3.0;

        if (predicate(f(m1), f(m2)))
            hi = m2;
        else
            lo = m1;
    }

    return (lo + hi) / 2.0;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
