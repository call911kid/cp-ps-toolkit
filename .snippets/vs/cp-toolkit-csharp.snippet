    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>msbi (cpmsbi)</Title>
            <Shortcut>cpmsbi</Shortcut>
            <Description>Returns the 0-based index of the highest set bit, or -1 if n is 0.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static int GetHighestSetBitIndex<T>(T n) where T : IBinaryInteger<T>
    => n == T.Zero ? -1 : n.GetByteCount() * 8 - 1 - int.CreateTruncating(T.LeadingZeroCount(n));$end$]]></Code>
        </Snippet>
    </CodeSnippet>
