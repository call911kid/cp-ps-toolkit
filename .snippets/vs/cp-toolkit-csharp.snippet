    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>phi (cpphi)</Title>
            <Shortcut>cpphi</Shortcut>
            <Description>Computes Euler&apos;s Totient, counting integers in [1, n] coprime to n.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static T EulerTotient<T>(T n) where T : IBinaryInteger<T>
{
    T result = n;
    T two = T.CreateChecked(2);

    for (T p = two; p * p <= n; p += (p == two ? T.One : two))
    {
        if ((n % p) != T.Zero) continue;

        while ((n % p) == T.Zero)
            n /= p;

        result -= result / p;
    }

    if (n > T.One)
        result -= result / n;

    return result;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>phi (cp_phi)</Title>
