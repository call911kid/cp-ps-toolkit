    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>psum (cppsum)</Title>
            <Shortcut>cppsum</Shortcut>
            <Description>A 1D partial sum array providing O(1) range, prefix, and suffix queries with zero branches.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public sealed class PartialSum<T> where T : INumber<T>
{
    private readonly T[] _pref;
    public int Length => _pref.Length - 1;
    public T TotalSum => _pref[^1];
    public PartialSum(ReadOnlySpan<T> source)
    {
        _pref = new T[source.Length + 1];
        _pref[0] = T.Zero;
        for (int i = 0; i < source.Length; i++)
        {
            _pref[i + 1] = _pref[i] + source[i];
        }
    }
    public T Query(int left, int right)
        => _pref[right + 1] - _pref[left];
    public T Prefix(int right)
        => _pref[right + 1];
    public T Suffix(int left)
        => _pref[^1] - _pref[left];
    public T this[int left, int right] => Query(left, right);
    
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
