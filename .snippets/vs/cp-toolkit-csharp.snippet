    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>istp (cpistp)</Title>
            <Shortcut>cpistp</Shortcut>
            <Description>Checks whether n has exactly 3 positive divisors.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static bool IsPrime<T>(T n) where T : IBinaryInteger<T>
{
    T two = T.CreateChecked(2);
    T three = T.CreateChecked(3);

    if (n <= T.One) return false;
    if (n <= three) return true;
    if ((n % two) == T.Zero || (n % three) == T.Zero) return false;

    T step = T.CreateChecked(6);
    for (T i = T.CreateChecked(5); i * i <= n; i += step)
    {
        if ((n % i) == T.Zero || (n % (i + two)) == T.Zero)
            return false;
    }

    return true;
}

public static bool IsTPrime<T>(T n) where T : IBinaryInteger<T>
{
    if (n < T.CreateChecked(4)) return false;

    double sqrtVal = Math.Round(Math.Sqrt(double.CreateChecked(n)));
    T root = T.CreateChecked(sqrtVal);

    return (root * root == n) && IsPrime(root);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
