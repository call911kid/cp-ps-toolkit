    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>m2s (cpm2s)</Title>
            <Shortcut>cpm2s</Shortcut>
            <Description>Reconstructs a sorted string of lowercase English letters from a 26-bit integer mask.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="csharp"><![CDATA[public static string MaskToString(int mask)
{
    Span<char> buffer = stackalloc char[26];
    int len = 0;
    for (int i = 0; i < 26; i++)
    {
        if (((mask >> i) & 1) == 1)
        {
            buffer[len++] = (char)('a' + i);
        }
    }

    return new string(buffer[..len]);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
