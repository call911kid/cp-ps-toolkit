    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>printv (cpprintv)</Title>
            <Shortcut>cpprintv</Shortcut>
            <Description>Prints elements of a vector separated by a delimiter followed by a newline.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[template <typename T>
inline void Println(const vector<T>& vec, const string& sep = " ")
{
    for (size_t i = 0; i < vec.size(); ++i)
    {
        if (i > 0) cout << sep;
        cout << vec[i];
    }
    cout << '\n';
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
