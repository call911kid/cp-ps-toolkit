    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>isp2 (cpisp2)</Title>
            <Shortcut>cpisp2</Shortcut>
            <Description>Checks whether n is a positive power of two (n &gt; 0 and (n &amp; (n - 1)) == 0).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[bool IsPowerOfTwo(long long n)
{
    return n > 0 && has_single_bit((unsigned long long)n);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
