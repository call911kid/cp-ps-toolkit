    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>popc (cppopc)</Title>
            <Shortcut>cppopc</Shortcut>
            <Description>Counts the total number of set bits (popcount).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[int CountSetBits(long long n)
{
    return popcount((unsigned long long)n);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
