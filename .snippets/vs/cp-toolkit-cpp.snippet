    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>nextp (cpnextp)</Title>
            <Shortcut>cpnextp</Shortcut>
            <Description>Returns the lexicographically next integer with the same number of set bits in O(1).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[long long NextPermutation(long long mask)
{
    unsigned long long umask = mask;
    unsigned long long c = umask & -umask;
    unsigned long long r = umask + c;
    return (((r ^ umask) >> (countr_zero(c) + 2)) | r);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>nextp (cp_nextp)</Title>
