    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>clsb (cpclsb)</Title>
            <Shortcut>cpclsb</Shortcut>
            <Description>Clears the lowest set bit (LSB) of n (n &amp; (n - 1)).</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[long long ClearLowestSetBit(long long n)
{
    return n & (n - 1LL);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
