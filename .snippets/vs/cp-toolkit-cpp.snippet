    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>fileio (cpfileio)</Title>
            <Shortcut>cpfileio</Shortcut>
            <Description>Redirects standard streams to local files for offline testing.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[inline void FileIO(const char* inputFile = "input.txt", const char* outputFile = "output.txt")
{
#ifndef ONLINE_JUDGE
    freopen(inputFile, "r", stdin);
    freopen(outputFile, "w", stdout);
#endif
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
