    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>m2s (cpm2s)</Title>
            <Shortcut>cpm2s</Shortcut>
            <Description>Reconstructs a sorted string of lowercase English letters from a 26-bit integer mask.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[string MaskToString(int mask)
{
    string result;
    result.reserve(26);
    for (int i = 0; i < 26; ++i)
    {
        if ((mask >> i) & 1)
        {
            result += static_cast<char>('a' + i);
        }
    }
    return result;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
