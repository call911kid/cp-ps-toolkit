    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>fastio (cpfastio)</Title>
            <Shortcut>cpfastio</Shortcut>
            <Description>Desynchronizes C/C++ standard streams and unties cin for fast I/O.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[inline void FastIO()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
