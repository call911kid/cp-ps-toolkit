    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>rbit (cprbit)</Title>
            <Shortcut>cprbit</Shortcut>
            <Description>Reverses the lowest bitCount bits of n.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[long long ReverseBits(long long n, int bitCount)
{
    long long rev = 0;
    for (int i = 0; i < bitCount; ++i)
    {
        rev = (rev << 1) | ((n >> i) & 1LL);
    }
    return rev;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
