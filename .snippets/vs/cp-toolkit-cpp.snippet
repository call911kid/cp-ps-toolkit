    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>cbit (cpcbit)</Title>
            <Shortcut>cpcbit</Shortcut>
            <Description>Clears the bit at the given 0-based index to 0.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[long long ClearBit(long long n, int index)
{
    return n & ~(1LL << index);
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
