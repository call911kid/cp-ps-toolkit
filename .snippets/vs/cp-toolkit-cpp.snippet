    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>printm (cpprintm)</Title>
            <Shortcut>cpprintm</Shortcut>
            <Description>Prints a 2D matrix row by row followed by newlines.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[template <typename T>
inline void PrintMatrix(const vector<vector<T>>& matrix, const string& sep = " ")
{
    for (const auto& row : matrix)
    {
        for (size_t i = 0; i < row.size(); ++i)
        {
            if (i > 0) cout << sep;
            cout << row[i];
        }
        cout << '\n';
    }
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
    <CodeSnippet Format="1.0.0">
        <Header>
