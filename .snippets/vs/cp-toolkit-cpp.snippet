<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>sbit (cpsbit)</Title>
            <Shortcut>cpsbit</Shortcut>
            <Description>Sets the bit at the given 0-based index to 1 (default), or to 0 if value is false.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[long long SetBit(long long n, int index, bool value = true)
{
    return value ? (n | (1LL << index)) : (n & ~(1LL << index));
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
