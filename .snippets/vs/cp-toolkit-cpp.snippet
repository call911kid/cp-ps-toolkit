    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>msbi (cpmsbi)</Title>
            <Shortcut>cpmsbi</Shortcut>
            <Description>Returns the 0-based index of the highest set bit, or -1 if n is 0.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[int GetHighestSetBitIndex(long long n)
{
    return n == 0 ? -1 : bit_width((unsigned long long)n) - 1;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
