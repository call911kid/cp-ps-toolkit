    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>isbit (cpisbit)</Title>
            <Shortcut>cpisbit</Shortcut>
            <Description>Checks if the bit at the given 0-based index is set to 1.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[bool IsBitSet(long long n, int index)
{
    return ((n >> index) & 1LL) == 1LL;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
