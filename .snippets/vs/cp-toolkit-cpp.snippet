                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[int GetLowestSetBitIndex(long long n)
{
    return n == 0 ? -1 : countr_zero((unsigned long long)n);
}$end$]]></Code>
        </Snippet>
