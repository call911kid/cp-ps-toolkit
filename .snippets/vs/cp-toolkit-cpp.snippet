    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>parity (cpparity)</Title>
            <Shortcut>cpparity</Shortcut>
            <Description>Checks whether the count of set bits in n is odd.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="cpp"><![CDATA[bool HasOddParity(long long n)
{
    return (popcount((unsigned long long)n) & 1) == 1;
}$end$]]></Code>
        </Snippet>
    </CodeSnippet>
