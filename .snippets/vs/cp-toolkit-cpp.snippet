    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>tbit (cptbit)</Title>
            <Shortcut>cptbit</Shortcut>
            <Description>Inverts (flips) the bit at the given 0-based index.</Description>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
