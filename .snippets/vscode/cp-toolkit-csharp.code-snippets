      "{",
      "    int n = source.Length;",
      "    var result = new int[n];",
      "    var stack = new int[n];",
      "    int top = 0;",
      "",
      "    for (int k = 0; k < n; k++)",
      "    {",
      "        int i = next ? n - 1 - k : k;",
      "        T curr = source[i];",
      "",
      "        while (top > 0 && shouldPop(source[stack[top - 1]], curr))",
      "            top--;",
      "",
      "        result[i] = top > 0 ? stack[top - 1] : emptyValue;",
      "        stack[top++] = i;",
      "    }",
      "",
      "    return result;",
      "}"
    ],
