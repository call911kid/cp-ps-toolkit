    "body": [
      "long long ReverseBits(long long n, int bitCount)",
      "{",
      "    long long rev = 0;",
      "    for (int i = 0; i < bitCount; ++i)",
      "    {",
      "        rev = (rev << 1) | ((n >> i) & 1LL);",
      "    }",
      "    return rev;",
      "}"
    ],
    "description": "Reverses the lowest bitCount bits of n."
  },
